FROM oven/bun:1.3.14 AS backend-dependencies

WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM oven/bun:1.3.14 AS build

WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY frontend/package.json frontend/bun.lock ./frontend/
RUN bun install --cwd frontend --frozen-lockfile

COPY tsconfig.json ./
COPY design ./design
COPY generated ./generated
COPY src ./src
COPY frontend ./frontend

ARG BACKEND_ORIGIN=http://127.0.0.1:4000
ENV BACKEND_ORIGIN=${BACKEND_ORIGIN}
RUN bun run --cwd frontend build

FROM oven/bun:1.3.14 AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    HOST=127.0.0.1 \
    PORT=4000 \
    HOSTNAME=0.0.0.0 \
    COMMONS_BACKEND_PORT=4000 \
    COMMONS_FRONTEND_PORT=3000 \
    BACKEND_ORIGIN=http://127.0.0.1:4000

COPY --from=build --chown=bun:bun /app/frontend/.next/standalone ./
COPY --from=build --chown=bun:bun /app/frontend/.next/static ./frontend/.next/static
COPY --from=backend-dependencies --chown=bun:bun /app/node_modules ./node_modules
COPY --chown=bun:bun package.json tsconfig.json ./
COPY --chown=bun:bun design ./design
COPY --chown=bun:bun src ./src
COPY --chown=bun:bun scripts/start-platform.ts ./scripts/start-platform.ts

USER bun
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD ["bun", "-e", "const r=await fetch(`http://127.0.0.1:${process.env.COMMONS_FRONTEND_PORT ?? '3000'}/health`);if(!r.ok)process.exit(1)"]

CMD ["bun", "scripts/start-platform.ts"]
