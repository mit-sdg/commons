FROM oven/bun:1.3.14 AS dependencies

WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY frontend/package.json frontend/bun.lock ./frontend/
RUN bun install --cwd frontend --frozen-lockfile

FROM dependencies AS build

WORKDIR /app
COPY tsconfig.json ./
COPY design ./design
COPY generated ./generated
COPY src ./src
COPY frontend ./frontend

ARG BACKEND_ORIGIN=http://backend:4000
ENV BACKEND_ORIGIN=${BACKEND_ORIGIN}
RUN bun run --cwd frontend build

FROM oven/bun:1.3.14 AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000

COPY --from=build --chown=bun:bun /app/frontend/.next/standalone ./
COPY --from=build --chown=bun:bun /app/frontend/.next/static ./frontend/.next/static

USER bun
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD ["bun", "-e", "const r=await fetch(`http://127.0.0.1:${process.env.PORT ?? '3000'}/health`);if(!r.ok)process.exit(1)"]

CMD ["bun", "frontend/server.js"]
