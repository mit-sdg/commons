{
  "name": "commons",
  "version": "0.1.0",
  "private": true,
  "description": "A learning application composed from concepts, reactions, views, and formers over the sync engine",
  "license": "Apache-2.0",
  "author": "Barish Namazov and Eagon Meng",
  "type": "module",
  "scripts": {
    "artifacts": "sync-engine artifacts",
    "design:check": "sync-engine check-design design/concepts/*.md design/compositions/*/*.md design/application.md",
    "source:check": "sync-engine check --config generated.config.ts",
    "issues:check": "bun scripts/check-issues.ts",
    "check": "bun run design:check && bun run source:check && bun run artifacts check && bun run issues:check && vp check && bun run --cwd frontend check",
    "build": "BACKEND_ORIGIN=http://127.0.0.1:4000 bun run --cwd frontend build && bun scripts/prepare-platform.ts",
    "platform:start": "bun scripts/start-platform.ts",
    "test": "bun run design:check && bun run source:check && bun run artifacts check && bun run issues:check && LOG_LEVEL=error node ./node_modules/vite-plus/bin/vp test && bun run --cwd frontend test",
    "typecheck": "tsc --noEmit",
    "spec": "bun run artifacts spec",
    "spec:pin": "bun run artifacts pin-spec",
    "wire": "bun run artifacts wire",
    "wire:pin": "bun run artifacts pin-wire",
    "serve": "bun src/start.ts",
    "setup:hash": "bun scripts/hash-setup-secret.ts",
    "scenario": "bun src/scenario.ts",
    "dev": "bun scripts/stack-mongo.ts",
    "e2e": "playwright test",
    "start": "bun scripts/stack-mongo.ts",
    "stack": "bun scripts/stack.ts",
    "stack:mongo": "bun scripts/stack-mongo.ts"
  },
  "dependencies": {
    "@mit-sdg/sync-engine": "1.0.0-beta.16",
    "@mit-sdg/sync-engine-http": "1.0.0-beta.16",
    "marked": "^18.0.6",
    "mongodb": "^7.2.0",
    "nodemailer": "^9.0.5",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@mit-sdg/sync-engine-analysis": "1.0.0-beta.16",
    "@mit-sdg/sync-engine-catalog": "1.0.0-beta.16",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^6.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vite-plus": "0.2.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
