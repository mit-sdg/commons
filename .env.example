# Local startup needs no variables. Copy this file to .env and uncomment what
# you want to override. Production startup requires PUBLIC_ORIGIN.
# `bun run stack:mongo` supplies its own local MONGODB_URL; `bun run stack`
# uses the values here.

# MONGODB_URL — operator-owned MongoDB for every stateful concept. Include the
# database name in the URL path. Omit the variable for memory.
# MONGODB_URL=mongodb://localhost:27017/commons

# PORT — port the HTTP edge listens on (default: 4000).
# PORT=4000

# WEB_PORT — port the local frontend listens on (default: 3000).
# WEB_PORT=3000

# BACKEND_ORIGIN — edge origin for a separately run frontend. The root stack
# commands set this from PORT so both processes stay together.
# BACKEND_ORIGIN=http://localhost:4000

# PUBLIC_ORIGIN — exact browser origin accepted by the HTTP edge.
# PUBLIC_ORIGIN=https://commons.example.edu
