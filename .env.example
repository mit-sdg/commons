# Commons requires MongoDB. Direct process startup uses MONGODB_URL; the
# production Compose stack creates MongoDB and constructs that URL itself.
# Production startup also requires PUBLIC_ORIGIN.
# `bun run stack:mongo` supplies its own temporary local MONGODB_URL;
# `bun run stack` uses the value here.

# MONGODB_URL — MongoDB used by direct, non-Compose startup. Include the
# database name in the URL path.
# MONGODB_URL=mongodb://localhost:27017/commons

# Compose MongoDB settings. MONGODB_PASSWORD is required and must be URL-safe
# because Compose places it in the backend connection URL.
# MONGODB_USERNAME=commons
# MONGODB_PASSWORD=replace-with-output-from-openssl-rand-hex-32
# MONGODB_DATABASE=commons
# MONGODB_IMAGE=mongo:8.0

# HOST — interface the HTTP edge listens on (default: 127.0.0.1). Containers
# set this to 0.0.0.0 so the frontend can reach the edge.
# HOST=127.0.0.1

# PORT — port the HTTP edge listens on (default: 4000).
# PORT=4000

# WEB_PORT — port the local frontend listens on (default: 3000). In Compose,
# use COMMONS_FRONTEND_PORT and COMMONS_BACKEND_PORT instead.
# WEB_PORT=3000
# COMMONS_FRONTEND_PORT=3000
# COMMONS_BACKEND_PORT=4000

# BACKEND_ORIGIN — edge origin for a separately run frontend. The root stack
# commands set this from PORT so both processes stay together.
# BACKEND_ORIGIN=http://localhost:4000

# PUBLIC_ORIGIN — exact browser origin accepted by the HTTP edge.
# PUBLIC_ORIGIN=https://commons.example.edu

# INVITATION_SECRET — 32+ random bytes used to derive stable temporary
# invitation passwords without storing them. Required in production.
# INVITATION_SECRET=replace-with-a-long-random-secret

# ADMIN_SETUP_SECRET_HASH — optional scrypt verifier enabling the one-time
# POST /api/setup/register-admin operator endpoint. Generate it with
# `printf %s "$SECRET" | bun run setup:hash`. Remove it after setup succeeds.
# The raw setup secret does not belong in this file or the deployment environment.
# ADMIN_SETUP_SECRET_HASH=$scrypt$N=16384,r=8,p=1$...

# SMTP email is enabled when SMTP_HOST and SMTP_FROM are present. Credentials
# are optional, but SMTP_USERNAME and SMTP_PASSWORD must be supplied together.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=commons
# SMTP_PASSWORD=change-me
# SMTP_FROM=Commons <no-reply@example.edu>
