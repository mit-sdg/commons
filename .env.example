# Commons requires MongoDB. Managed platforms should supply MONGODB_URI; direct
# process startup may use the MONGODB_URL alias. If both are nonempty they must match.
# Production startup also requires PUBLIC_ORIGIN.
# For local development, `bun dev` boots an in-memory MongoDB automatically unless
# MONGODB_URL is configured here.

# Include the database name in the MongoDB connection URL.
# MONGODB_URI=mongodb://localhost:27017/commons
# MONGODB_URL=mongodb://localhost:27017/commons

# HOST — interface the HTTP edge listens on (default: 127.0.0.1).
# HOST=127.0.0.1

# PORT — port the HTTP edge listens on (default: 4000).
# PORT=4000

# WEB_PORT — port the local frontend listens on (default: 3000).
# WEB_PORT=3000

# WEB_HOST — interface the local frontend listens on. When PUBLIC_ORIGIN or
# PARTICIPANT_ORIGIN is set, the stack defaults this to 0.0.0.0 so phones on
# the LAN can reach it.
# WEB_HOST=0.0.0.0

# PARTICIPANT_ORIGIN — the address phones reach, printed under every QR code
# and on every join screen, when the edge itself stays on loopback: a laptop
# serving a room over plain http. Set it during the build for a production
# stack, or in the environment of `bun dev`.
# PARTICIPANT_ORIGIN=http://192.168.1.20:3000

# BACKEND_ORIGIN — edge origin for a separately run frontend. The root stack
# commands set this from PORT so both processes stay together.
# BACKEND_ORIGIN=http://localhost:4000

# PUBLIC_ORIGIN — exact browser origin accepted by the HTTP edge and, unless
# PARTICIPANT_ORIGIN is set, encoded in live QR codes. Set it during both the
# production build and runtime. The edge accepts only https or a loopback
# host here, so a LAN address goes in PARTICIPANT_ORIGIN instead.
# PUBLIC_ORIGIN=https://commons.example.edu

# The AI reasoner is enabled only when GEMINI_API_KEY is present. GEMINI_MODEL
# is optional. REASONER may be "gemini" or, outside production only,
# "scripted" for deterministic local demos and tests.
# REASONER=gemini
# GEMINI_API_KEY=replace-with-a-gemini-api-key
# GEMINI_MODEL=gemini-3.7-flash

# INVITATION_SECRET — 32+ random bytes used to derive stable temporary
# invitation passwords without storing them. Required in production, where
# startup refuses anything shorter than 32 characters.
# INVITATION_SECRET=replace-with-a-long-random-secret

# VOUCHER_SECRET — 32+ random bytes used to derive password-reset codes
# without storing them. Required in production, where startup refuses anything
# shorter than 32 characters or equal to INVITATION_SECRET.
# VOUCHER_SECRET=replace-with-a-different-long-random-secret

# ADMIN_SETUP_SECRET_HASH — optional scrypt verifier enabling the one-time
# POST /api/setup/register-admin operator endpoint. Generate it with
# `printf %s "$SECRET" | bun run setup:hash`. Remove it after setup succeeds.
# The raw setup secret does not belong in this file or the deployment environment.
# ADMIN_SETUP_SECRET_HASH=$scrypt$N=16384,r=8,p=1$...

# SMTP email is enabled when SMTP_HOST and SMTP_FROM are present. Credentials
# are optional, but SMTP_USERNAME and SMTP_PASSWORD must be supplied together.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=commons
# SMTP_PASSWORD=change-me
# SMTP_FROM is independent of SMTP_USERNAME and may include a display name.
# Your SMTP provider must authorize this sender address/domain.
# SMTP_FROM="Commons <no-reply@example.edu>"
# SMTP_REPLY_TO is optional; without it, replies go to SMTP_FROM.
# SMTP_REPLY_TO="Course Team <course@example.edu>"
# Invitation subject/body are editable in Administration > Email, not in env.
